{"id":1,"fn":"x","text":"reverse a list","examples":[{"in":[[1,2,3]],"out":[3,2,1]},{"in":[[5]],"out":[5]},{"in":[[4,9]],"out":[9,4]}]}
{"id":2,"fn":"x","text":"sort a list in ascending order","examples":[{"in":[[3,1,2]],"out":[1,2,3]},{"in":[[5,4]],"out":[4,5]},{"in":[[9]],"out":[9]}]}
{"id":3,"fn":"x","text":"the absolute value of a number","examples":[{"in":[-3],"out":3},{"in":[5],"out":5},{"in":[0],"out":0}]}
{"id":4,"fn":"x","text":"the sum of a list of numbers","examples":[{"in":[[1,2,3]],"out":6},{"in":[[5,-2]],"out":3},{"in":[[10]],"out":10}]}
{"id":5,"fn":"x","text":"the maximum element in a list","examples":[{"in":[[3,9,2]],"out":9},{"in":[[-1,-5]],"out":-1},{"in":[[7]],"out":7}]}
{"id":6,"fn":"x","text":"count the vowels in a string","examples":[{"in":["hello"],"out":2},{"in":["xyz"],"out":0},{"in":["aeiou"],"out":5}]}
