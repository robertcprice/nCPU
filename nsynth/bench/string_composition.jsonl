{"id": 11, "fn": "sentence_case", "text": "capitalize only the first letter", "examples": [{"in": ["hello world"], "out": "Hello world"}, {"in": ["the fox"], "out": "The fox"}, {"in": ["one two"], "out": "One two"}, {"in": ["foo bar"], "out": "Foo bar"}, {"in": ["abc def"], "out": "Abc def"}, {"in": ["x y"], "out": "X y"}]}
