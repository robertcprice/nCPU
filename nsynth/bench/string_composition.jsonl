{"id": 8, "fn": "uppercase", "text": "convert to uppercase", "examples": [{"in": ["hello"], "out": "HELLO"}, {"in": ["world"], "out": "WORLD"}, {"in": ["abc"], "out": "ABC"}, {"in": ["Foo"], "out": "FOO"}, {"in": ["mixED"], "out": "MIXED"}, {"in": ["test"], "out": "TEST"}]}
{"id": 9, "fn": "reverse_string", "text": "reverse the string", "examples": [{"in": ["hello"], "out": "olleh"}, {"in": ["world"], "out": "dlrow"}, {"in": ["abc"], "out": "cba"}, {"in": ["racecar"], "out": "racecar"}, {"in": ["xyz"], "out": "zyx"}, {"in": ["foo"], "out": "oof"}]}
