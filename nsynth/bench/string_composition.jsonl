{"id": 5, "fn": "longest_word", "text": "the longest word in the sentence", "examples": [{"in": ["hello world"], "out": "hello"}, {"in": ["the quick brown fox"], "out": "quick"}, {"in": ["one two three"], "out": "three"}, {"in": ["foo bar baz"], "out": "foo"}, {"in": ["a bb ccc"], "out": "ccc"}, {"in": ["alpha beta"], "out": "alpha"}]}
{"id": 6, "fn": "shortest_word", "text": "the shortest word in the sentence", "examples": [{"in": ["hello world"], "out": "hello"}, {"in": ["the quick brown fox"], "out": "the"}, {"in": ["one two three"], "out": "one"}, {"in": ["foo bar baz"], "out": "foo"}, {"in": ["a bb ccc"], "out": "a"}, {"in": ["alpha beta"], "out": "beta"}]}
