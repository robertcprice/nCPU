{"id":2001,"category":"int","hardness":"easy","fn":"is_power_of_two","text":"whether a number is a power of two","examples":[{"in":[1],"out":1},{"in":[2],"out":1},{"in":[3],"out":0},{"in":[4],"out":1},{"in":[8],"out":1},{"in":[6],"out":0}]}
{"id":2002,"category":"int","hardness":"medium","fn":"digital_root","text":"the digital root of a number","examples":[{"in":[0],"out":0},{"in":[9],"out":9},{"in":[18],"out":9},{"in":[123],"out":6},{"in":[10],"out":1},{"in":[99],"out":9}]}
{"id":2003,"category":"int","hardness":"medium","fn":"nth_triangular","text":"the nth triangular number","examples":[{"in":[0],"out":0},{"in":[1],"out":1},{"in":[2],"out":3},{"in":[3],"out":6},{"in":[4],"out":10},{"in":[5],"out":15}]}
{"id":2004,"category":"int","hardness":"medium","fn":"sum_proper_divisors","text":"the sum of the proper divisors of a number","examples":[{"in":[6],"out":6},{"in":[12],"out":16},{"in":[1],"out":0},{"in":[7],"out":1},{"in":[28],"out":28}]}
{"id":2005,"category":"int","hardness":"easy","fn":"square","text":"the square of a number","examples":[{"in":[0],"out":0},{"in":[3],"out":9},{"in":[5],"out":25},{"in":[-4],"out":16},{"in":[10],"out":100}]}
{"id":2006,"category":"int","hardness":"easy","fn":"cube","text":"the cube of a number","examples":[{"in":[0],"out":0},{"in":[2],"out":8},{"in":[3],"out":27},{"in":[-2],"out":-8},{"in":[4],"out":64}]}
{"id":2007,"category":"int","hardness":"medium","fn":"num_divisors","text":"the number of divisors of a number","examples":[{"in":[1],"out":1},{"in":[6],"out":4},{"in":[7],"out":2},{"in":[12],"out":6},{"in":[16],"out":5}]}
{"id":2008,"category":"int","hardness":"hard","fn":"is_perfect","text":"whether a number is a perfect number","examples":[{"in":[6],"out":1},{"in":[28],"out":1},{"in":[12],"out":0},{"in":[7],"out":0},{"in":[496],"out":1}]}
{"id":2009,"category":"array","hardness":"medium","fn":"second_largest","text":"the second largest value in a list","examples":[{"in":[[3,1,2]],"out":2},{"in":[[9,5,7]],"out":7},{"in":[[1,4,2,8]],"out":4},{"in":[[10,20]],"out":10}]}
{"id":2010,"category":"array","hardness":"medium","fn":"is_sorted","text":"whether a list is sorted in ascending order","examples":[{"in":[[1,2,3]],"out":1},{"in":[[1,3,2]],"out":0},{"in":[[5]],"out":1},{"in":[[2,2,3]],"out":1},{"in":[[9,1]],"out":0}]}
{"id":2011,"category":"array","hardness":"medium","fn":"range_span","text":"the difference between the largest and smallest values in a list","examples":[{"in":[[3,1,7]],"out":6},{"in":[[5,5]],"out":0},{"in":[[10,2,8]],"out":8},{"in":[[-4,4]],"out":8}]}
{"id":2012,"category":"array","hardness":"easy","fn":"count_positives","text":"how many numbers in a list are greater than zero","examples":[{"in":[[1,-2,3]],"out":2},{"in":[[-1,-2]],"out":0},{"in":[[4,5,6]],"out":3},{"in":[[0,1]],"out":1}]}
{"id":2013,"category":"array","hardness":"hard","fn":"sum_of_even_squares","text":"the sum of the squares of the even numbers in a list","examples":[{"in":[[1,2,3,4]],"out":20},{"in":[[2]],"out":4},{"in":[[1,3]],"out":0},{"in":[[2,4]],"out":20},{"in":[[6]],"out":36}]}
{"id":2014,"category":"string","hardness":"medium","fn":"count_words","text":"the number of words in a sentence","examples":[{"in":["hello world"],"out":2},{"in":["one"],"out":1},{"in":["a b c d"],"out":4},{"in":["the quick brown fox"],"out":4}]}
{"id":2015,"category":"string","hardness":"medium","fn":"count_consonants","text":"the number of consonants in a string","examples":[{"in":["hello"],"out":3},{"in":["aeiou"],"out":0},{"in":["xyz"],"out":3},{"in":["abc"],"out":2}]}
{"id":2016,"category":"composition","hardness":"medium","fn":"triple_then_add_two","text":"three times a number plus two","examples":[{"in":[0],"out":2},{"in":[1],"out":5},{"in":[3],"out":11},{"in":[5],"out":17},{"in":[-1],"out":-1}]}
{"id":2017,"category":"composition","hardness":"medium","fn":"half_the_max","text":"half of the maximum value in a list","examples":[{"in":[[2,8]],"out":4},{"in":[[10,4,6]],"out":5},{"in":[[100]],"out":50},{"in":[[2,20,8]],"out":10}]}
{"id":2018,"category":"int","hardness":"medium","fn":"reverse_number","text":"reverse the digits of a number","examples":[{"in":[123],"out":321},{"in":[100],"out":1},{"in":[5],"out":5},{"in":[4021],"out":1204}]}
{"id":2019,"category":"array","hardness":"medium","fn":"product_of_list","text":"the product of a list of numbers","examples":[{"in":[[2,3]],"out":6},{"in":[[1,5]],"out":5},{"in":[[2,2,2]],"out":8},{"in":[[-2,4]],"out":-8},{"in":[[7]],"out":7}]}
{"id":2020,"category":"int","hardness":"medium","fn":"count_set_bits","text":"the number of set bits in a number","examples":[{"in":[0],"out":0},{"in":[7],"out":3},{"in":[8],"out":1},{"in":[255],"out":8},{"in":[6],"out":2}]}
