{"id":101,"category":"int","hardness":"easy","fn":"multiply","text":"multiply two numbers","examples":[{"in":[2,3],"out":6},{"in":[4,5],"out":20},{"in":[0,7],"out":0},{"in":[9,9],"out":81}]}
{"id":102,"category":"int","hardness":"easy","fn":"abs","text":"the absolute value of a number","examples":[{"in":[-3],"out":3},{"in":[5],"out":5},{"in":[-10],"out":10},{"in":[0],"out":0}]}
{"id":103,"category":"int","hardness":"medium","fn":"gcd","text":"the greatest common divisor of two numbers","examples":[{"in":[12,18],"out":6},{"in":[100,60],"out":20},{"in":[7,3],"out":1},{"in":[48,36],"out":12}]}
{"id":104,"category":"int","hardness":"medium","fn":"sum_digits","text":"the sum of the digits of a number","examples":[{"in":[123],"out":6},{"in":[99],"out":18},{"in":[5],"out":5},{"in":[4021],"out":7}]}
{"id":105,"category":"int","hardness":"medium","fn":"is_prime","text":"whether a number is prime","examples":[{"in":[7],"out":1},{"in":[8],"out":0},{"in":[2],"out":1},{"in":[1],"out":0}]}
{"id":106,"category":"int","hardness":"medium","fn":"factorial","text":"the factorial of a number","examples":[{"in":[0],"out":1},{"in":[3],"out":6},{"in":[5],"out":120},{"in":[4],"out":24}]}
{"id":107,"category":"int","hardness":"hard","fn":"nth_fib","text":"the nth fibonacci number","examples":[{"in":[0],"out":0},{"in":[1],"out":1},{"in":[7],"out":13},{"in":[10],"out":55}]}
{"id":108,"category":"int","hardness":"hard","fn":"popcount","text":"the number of set bits in a number","examples":[{"in":[0],"out":0},{"in":[7],"out":3},{"in":[255],"out":8},{"in":[1],"out":1}]}
{"id":109,"category":"int","hardness":"hard","fn":"collatz","text":"the number of steps to reach one in the collatz sequence","examples":[{"in":[1],"out":0},{"in":[6],"out":8},{"in":[7],"out":16},{"in":[27],"out":111}]}
{"id":201,"category":"string","hardness":"easy","fn":"reverse_string","text":"reverse a string","examples":[{"in":["abc"],"out":"cba"},{"in":["hello"],"out":"olleh"},{"in":["x"],"out":"x"},{"in":["ab"],"out":"ba"}]}
{"id":202,"category":"string","hardness":"easy","fn":"to_upper","text":"convert a string to uppercase","examples":[{"in":["abc"],"out":"ABC"},{"in":["Hi"],"out":"HI"},{"in":["z"],"out":"Z"},{"in":["a b"],"out":"A B"}]}
{"id":203,"category":"string","hardness":"medium","fn":"is_palindrome","text":"whether a string is a palindrome","examples":[{"in":["aba"],"out":1},{"in":["abc"],"out":0},{"in":["aa"],"out":1},{"in":["abca"],"out":0}]}
{"id":204,"category":"string","hardness":"medium","fn":"count_vowels","text":"count the vowels in a string","examples":[{"in":["hello"],"out":2},{"in":["xyz"],"out":0},{"in":["aeiou"],"out":5},{"in":["abc"],"out":1}]}
{"id":205,"category":"string","hardness":"medium","fn":"concat","text":"concatenate two strings","examples":[{"in":["foo","bar"],"out":"foobar"},{"in":["a","b"],"out":"ab"},{"in":["hi","!"],"out":"hi!"},{"in":["x","yz"],"out":"xyz"}]}
{"id":301,"category":"array","hardness":"easy","fn":"sum_list","text":"the sum of a list of numbers","examples":[{"in":[[1,2,3]],"out":6},{"in":[[5]],"out":5},{"in":[[10,20]],"out":30},{"in":[[4,4,4]],"out":12},{"in":[[-2,5]],"out":3}]}
{"id":302,"category":"array","hardness":"easy","fn":"max_list","text":"the maximum value in a list","examples":[{"in":[[1,5,3]],"out":5},{"in":[[7]],"out":7},{"in":[[9,2,9]],"out":9},{"in":[[-1,-5]],"out":-1}]}
{"id":303,"category":"array","hardness":"medium","fn":"reverse_list","text":"reverse a list of numbers","examples":[{"in":[[1,2,3]],"out":[3,2,1]},{"in":[[9]],"out":[9]},{"in":[[1,2]],"out":[2,1]},{"in":[[4,5,6,7]],"out":[7,6,5,4]}]}
{"id":304,"category":"array","hardness":"medium","fn":"sort_list","text":"sort a list of numbers in ascending order","examples":[{"in":[[3,1,2]],"out":[1,2,3]},{"in":[[5]],"out":[5]},{"in":[[2,1]],"out":[1,2]},{"in":[[9,7,8]],"out":[7,8,9]}]}
{"id":305,"category":"array","hardness":"medium","fn":"count_evens","text":"count the even numbers in a list","examples":[{"in":[[1,2,3,4]],"out":2},{"in":[[1,3]],"out":0},{"in":[[2,4,6]],"out":3},{"in":[[0,1,2]],"out":2}]}
{"id":401,"category":"composition","hardness":"medium","fn":"sum_squares","text":"the sum of the squares of a list of numbers","examples":[{"in":[[1,2,3]],"out":14},{"in":[[2]],"out":4},{"in":[[1,1,1]],"out":3},{"in":[[3,4]],"out":25}]}
{"id":402,"category":"composition","hardness":"medium","fn":"product_list","text":"the product of a list of numbers","examples":[{"in":[[1,2,3]],"out":6},{"in":[[5]],"out":5},{"in":[[2,2,2]],"out":8},{"in":[[4,3]],"out":12},{"in":[[-2,4]],"out":-8}]}
{"id":403,"category":"composition","hardness":"hard","fn":"reverse_then_first","text":"the first element after reversing a list","examples":[{"in":[[1,2,3]],"out":3},{"in":[[9,8]],"out":8},{"in":[[5]],"out":5},{"in":[[7,1,2,4]],"out":4}]}
{"id":404,"category":"composition","hardness":"hard","fn":"sum_of_evens","text":"the sum of the even numbers in a list","examples":[{"in":[[1,2,3,4]],"out":6},{"in":[[1,3]],"out":0},{"in":[[2,4,6]],"out":12},{"in":[[5,2]],"out":2}]}
{"id":501,"category":"float","hardness":"medium","fn":"average","text":"the average of a list of numbers","examples":[{"in":[[1,2,3]],"out":2.0},{"in":[[4,4]],"out":4.0},{"in":[[2,4,6]],"out":4.0},{"in":[[10]],"out":10.0},{"in":[[0,10]],"out":5.0}]}
{"id":502,"category":"float","hardness":"medium","fn":"scale_half","text":"a number multiplied by one and a half","examples":[{"in":[2.0],"out":3.0},{"in":[4.0],"out":6.0},{"in":[10.0],"out":15.0},{"in":[0.0],"out":0.0}]}
{"id":601,"category":"map","hardness":"hard","fn":"count_each","text":"a map from each value in a list to how many times it appears","examples":[{"in":[[1,1,2]],"out":{"__map__":[[1,2],[2,1]]}},{"in":[[3]],"out":{"__map__":[[3,1]]}},{"in":[[5,5,5]],"out":{"__map__":[[5,3]]}},{"in":[[1,2,2,3]],"out":{"__map__":[[1,1],[2,2],[3,1]]}}]}
{"id":701,"category":"int","hardness":"hard","fn":"num_divisors","text":"the number of divisors of a number","examples":[{"in":[6],"out":4},{"in":[7],"out":2},{"in":[12],"out":6},{"in":[1],"out":1}]}
{"id":702,"category":"string","hardness":"hard","fn":"first_word","text":"the first word of a sentence","examples":[{"in":["hello world"],"out":"hello"},{"in":["one two three"],"out":"one"},{"in":["single"],"out":"single"},{"in":["a b c"],"out":"a"}]}
{"id":801,"category":"array","hardness":"medium","fn":"all_same","text":"whether all elements in a list are the same","examples":[{"in":[[2,2,2]],"out":1},{"in":[[1,2]],"out":0},{"in":[[5,5]],"out":1},{"in":[[3,4,5]],"out":0}]}
{"id":802,"category":"int","hardness":"medium","fn":"is_perfect_cube","text":"whether a number is a perfect cube","examples":[{"in":[1],"out":1},{"in":[8],"out":1},{"in":[27],"out":1},{"in":[4],"out":0},{"in":[9],"out":0}]}
