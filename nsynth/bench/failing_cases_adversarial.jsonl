{"id":1301,"category":"array","hardness":"medium","fn":"sum_list","text":"the sum of a list of numbers","examples":[{"in":[[-1,5]],"out":4},{"in":[[3,-10,3]],"out":-4},{"in":[[10,20]],"out":30},{"in":[[4,4,4]],"out":12},{"in":[[0,0]],"out":0}]}
{"id":1302,"category":"array","hardness":"medium","fn":"max_list","text":"the maximum value in a list","examples":[{"in":[[-1,-5,-3]],"out":-1},{"in":[[7]],"out":7},{"in":[[1,5,3]],"out":5},{"in":[[-9,2]],"out":2},{"in":[[-4,-4]],"out":-4}]}
{"id":1303,"category":"array","hardness":"medium","fn":"min_list","text":"the minimum value in a list","examples":[{"in":[[3,1,2]],"out":1},{"in":[[-1,5]],"out":-1},{"in":[[7]],"out":7},{"in":[[-9,-2]],"out":-9},{"in":[[0,4,0]],"out":0}]}
{"id":1402,"category":"array","hardness":"medium","fn":"product_list","text":"the product of a list of numbers","examples":[{"in":[[-2,3]],"out":-6},{"in":[[2,2,2]],"out":8},{"in":[[5]],"out":5},{"in":[[0,4]],"out":0},{"in":[[-1,-1,3]],"out":3}]}
{"id":1401,"category":"composition","hardness":"medium","fn":"sum_squares","text":"the sum of the squares of a list of numbers","examples":[{"in":[[-1,2]],"out":5},{"in":[[3]],"out":9},{"in":[[1,1,1]],"out":3},{"in":[[-2,-3]],"out":13},{"in":[[0,5]],"out":25}]}
{"id":1404,"category":"composition","hardness":"hard","fn":"sum_of_evens","text":"the sum of the even numbers in a list","examples":[{"in":[[1,2,3,4]],"out":6},{"in":[[-2,3]],"out":-2},{"in":[[1,3]],"out":0},{"in":[[2,4,6]],"out":12},{"in":[[-4,-2,1]],"out":-6}]}
{"id":1305,"category":"array","hardness":"medium","fn":"count_evens","text":"count the even numbers in a list","examples":[{"in":[[1,2,3,4]],"out":2},{"in":[[-2,0,3]],"out":2},{"in":[[1,3]],"out":0},{"in":[[0,0,0]],"out":3},{"in":[[-4,-2]],"out":2}]}
{"id":1306,"category":"array","hardness":"medium","fn":"reverse_list","text":"reverse a list of numbers","examples":[{"in":[[-1,2,3]],"out":[3,2,-1]},{"in":[[9]],"out":[9]},{"in":[[1,-2]],"out":[-2,1]},{"in":[[3,1,2]],"out":[2,1,3]},{"in":[[0,5,6,7]],"out":[7,6,5,0]}]}
{"id":1307,"category":"array","hardness":"medium","fn":"sum_absolute_values","text":"the sum of the absolute values in a list","examples":[{"in":[[-3,-4]],"out":7},{"in":[[1,-2]],"out":3},{"in":[[5]],"out":5},{"in":[[-1,4]],"out":5}]}
{"id":1308,"category":"array","hardness":"medium","fn":"count_less_than_zero","text":"how many numbers in a list are less than zero","examples":[{"in":[[-1,2,-3]],"out":2},{"in":[[1,2]],"out":0},{"in":[[-5,-6]],"out":2},{"in":[[0,-1]],"out":1}]}
{"id":1309,"category":"array","hardness":"medium","fn":"min_even","text":"the smallest even number in a list","examples":[{"in":[[5,4,2,6]],"out":2},{"in":[[3,8,10]],"out":8},{"in":[[7,6,1,4]],"out":4},{"in":[[9,2,5]],"out":2}]}
{"id":1310,"category":"array","hardness":"medium","fn":"absolute_first_last_diff","text":"the absolute difference between the first and last element","examples":[{"in":[[3,1,8]],"out":5},{"in":[[5,1,2]],"out":3},{"in":[[4,9]],"out":5},{"in":[[10,4]],"out":6}]}
{"id":1311,"category":"array","hardness":"medium","fn":"sum_negatives","text":"the sum of the negative numbers in a list","examples":[{"in":[[1,-2,-3]],"out":-5},{"in":[[-4,5]],"out":-4},{"in":[[3,-1,-2]],"out":-3}]}
{"id":1312,"category":"array","hardness":"medium","fn":"absolute_first","text":"the absolute value of the first element of a list","examples":[{"in":[[-8,3]],"out":8},{"in":[[5,2]],"out":5},{"in":[[-1,9,4]],"out":1}]}
{"id":1313,"category":"array","hardness":"medium","fn":"absolute_last","text":"the absolute value of the last element of a list","examples":[{"in":[[3,-8]],"out":8},{"in":[[5,2]],"out":2},{"in":[[1,9,-4]],"out":4}]}
{"id":1314,"category":"array","hardness":"medium","fn":"absolute_product","text":"the absolute value of the product of a list","examples":[{"in":[[-2,3]],"out":6},{"in":[[2,2]],"out":4},{"in":[[-1,-5]],"out":5},{"in":[[4]],"out":4}]}
{"id":1315,"category":"array","hardness":"medium","fn":"max_even","text":"the largest even number in a list","examples":[{"in":[[3,4,6,7]],"out":6},{"in":[[2,9]],"out":2},{"in":[[5,8,3]],"out":8}]}
{"id":1316,"category":"composition","hardness":"hard","fn":"sum_odds","text":"the sum of the odd numbers in a list","examples":[{"in":[[1,2,3]],"out":4},{"in":[[4,5]],"out":5},{"in":[[2,7,1]],"out":8},{"in":[[6,3,4,1]],"out":4}]}
{"id":1317,"category":"composition","hardness":"hard","fn":"product_evens","text":"the product of the even numbers in a list","examples":[{"in":[[2,3,4]],"out":8},{"in":[[5,6]],"out":6},{"in":[[1,2,2]],"out":4},{"in":[[3,2,5,4]],"out":8}]}
{"id":1318,"category":"array","hardness":"medium","fn":"remove_duplicates","text":"remove duplicate values from a list","examples":[{"in":[[1,1,2]],"out":[1,2]},{"in":[[3,3,3]],"out":[3]},{"in":[[4,5,4]],"out":[4,5]}]}
{"id":1319,"category":"composition","hardness":"hard","fn":"sort_descending","text":"sort a list in descending order","examples":[{"in":[[1,3,2]],"out":[3,2,1]},{"in":[[4,5]],"out":[5,4]},{"in":[[9,1,5]],"out":[9,5,1]}]}
{"id":1320,"category":"string","hardness":"medium","fn":"to_upper","text":"convert a string to uppercase","examples":[{"in":["abc"],"out":"ABC"},{"in":["hi"],"out":"HI"},{"in":["dog"],"out":"DOG"}]}
{"id":1321,"category":"string","hardness":"medium","fn":"capitalize_first","text":"capitalize the first letter of a string","examples":[{"in":["abc"],"out":"Abc"},{"in":["hi"],"out":"Hi"},{"in":["dog"],"out":"Dog"}]}
{"id":1322,"category":"string","hardness":"medium","fn":"to_lower","text":"convert a string to lowercase","examples":[{"in":["ABC"],"out":"abc"},{"in":["HI"],"out":"hi"},{"in":["DOG"],"out":"dog"}]}
{"id":1323,"category":"int","hardness":"hard","fn":"fibonacci","text":"the nth fibonacci number","examples":[{"in":[0],"out":0},{"in":[1],"out":1},{"in":[5],"out":5},{"in":[6],"out":8},{"in":[7],"out":13}]}
{"id":1324,"category":"int","hardness":"hard","fn":"power","text":"raise a number to a power","examples":[{"in":[2,3],"out":8},{"in":[3,2],"out":9},{"in":[5,1],"out":5}]}
{"id":1325,"category":"int","hardness":"hard","fn":"is_perfect_square","text":"whether a number is a perfect square","examples":[{"in":[4],"out":1},{"in":[9],"out":1},{"in":[3],"out":0},{"in":[6],"out":0},{"in":[16],"out":1},{"in":[7],"out":0}]}
{"id":1326,"category":"int","hardness":"hard","fn":"is_coprime","text":"whether two numbers are coprime","examples":[{"in":[2,3],"out":1},{"in":[4,9],"out":1},{"in":[6,8],"out":0},{"in":[3,9],"out":0},{"in":[2,4],"out":0}]}
{"id":1327,"category":"int","hardness":"hard","fn":"is_prime","text":"whether a number is prime","examples":[{"in":[2],"out":1},{"in":[3],"out":1},{"in":[4],"out":0},{"in":[7],"out":1},{"in":[9],"out":0}]}
{"id":1328,"category":"string","hardness":"medium","fn":"is_palindrome","text":"whether a string is a palindrome","examples":[{"in":["aba"],"out":1},{"in":["abc"],"out":0},{"in":["aa"],"out":1},{"in":["ab"],"out":0}]}
{"id":1329,"category":"int","hardness":"hard","fn":"lcm","text":"the least common multiple of two numbers","examples":[{"in":[4,6],"out":12},{"in":[3,5],"out":15},{"in":[2,4],"out":4}]}
{"id":1330,"category":"int","hardness":"hard","fn":"armstrong_number","text":"whether a number is an armstrong number","examples":[{"in":[1],"out":1},{"in":[5],"out":1},{"in":[9],"out":1},{"in":[10],"out":0},{"in":[25],"out":0},{"in":[153],"out":1}]}
{"id":1331,"category":"string","hardness":"medium","fn":"all_uppercase","text":"whether a string is all uppercase","examples":[{"in":["AB"],"out":1},{"in":["XY"],"out":1},{"in":["ab"],"out":0},{"in":["aB"],"out":0},{"in":["Ab"],"out":0}]}
{"id":1332,"category":"string","hardness":"medium","fn":"all_letters","text":"whether a string contains only letters","examples":[{"in":["abc"],"out":1},{"in":["xyz"],"out":1},{"in":["1bc"],"out":0},{"in":["9yz"],"out":0},{"in":["ab1"],"out":0}]}
{"id":1333,"category":"composition","hardness":"hard","fn":"sum_is_positive","text":"whether the sum of a list is positive","examples":[{"in":[[-5,10]],"out":1},{"in":[[1,2]],"out":1},{"in":[[-8,-1]],"out":0},{"in":[[3,-10]],"out":0}]}
{"id":1334,"category":"string","hardness":"medium","fn":"ends_with_digit","text":"whether a string ends with a digit","examples":[{"in":["ab1"],"out":1},{"in":["xy9"],"out":1},{"in":["abc"],"out":0},{"in":["xyz"],"out":0},{"in":["a1b"],"out":0}]}
{"id":1335,"category":"int","hardness":"hard","fn":"odd_prime","text":"whether a number is prime and odd","examples":[{"in":[3],"out":1},{"in":[2],"out":0},{"in":[4],"out":0},{"in":[7],"out":1},{"in":[9],"out":0}]}
