{"id":1301,"category":"array","hardness":"medium","fn":"sum_list","text":"the sum of a list of numbers","examples":[{"in":[[-1,5]],"out":4},{"in":[[3,-10,3]],"out":-4},{"in":[[10,20]],"out":30},{"in":[[4,4,4]],"out":12},{"in":[[0,0]],"out":0}]}
{"id":1302,"category":"array","hardness":"medium","fn":"max_list","text":"the maximum value in a list","examples":[{"in":[[-1,-5,-3]],"out":-1},{"in":[[7]],"out":7},{"in":[[1,5,3]],"out":5},{"in":[[-9,2]],"out":2},{"in":[[-4,-4]],"out":-4}]}
{"id":1303,"category":"array","hardness":"medium","fn":"min_list","text":"the minimum value in a list","examples":[{"in":[[3,1,2]],"out":1},{"in":[[-1,5]],"out":-1},{"in":[[7]],"out":7},{"in":[[-9,-2]],"out":-9},{"in":[[0,4,0]],"out":0}]}
{"id":1402,"category":"array","hardness":"medium","fn":"product_list","text":"the product of a list of numbers","examples":[{"in":[[-2,3]],"out":-6},{"in":[[2,2,2]],"out":8},{"in":[[5]],"out":5},{"in":[[0,4]],"out":0},{"in":[[-1,-1,3]],"out":3}]}
{"id":1401,"category":"composition","hardness":"medium","fn":"sum_squares","text":"the sum of the squares of a list of numbers","examples":[{"in":[[-1,2]],"out":5},{"in":[[3]],"out":9},{"in":[[1,1,1]],"out":3},{"in":[[-2,-3]],"out":13},{"in":[[0,5]],"out":25}]}
{"id":1404,"category":"composition","hardness":"hard","fn":"sum_of_evens","text":"the sum of the even numbers in a list","examples":[{"in":[[1,2,3,4]],"out":6},{"in":[[-2,3]],"out":-2},{"in":[[1,3]],"out":0},{"in":[[2,4,6]],"out":12},{"in":[[-4,-2,1]],"out":-6}]}
{"id":1305,"category":"array","hardness":"medium","fn":"count_evens","text":"count the even numbers in a list","examples":[{"in":[[1,2,3,4]],"out":2},{"in":[[-2,0,3]],"out":2},{"in":[[1,3]],"out":0},{"in":[[0,0,0]],"out":3},{"in":[[-4,-2]],"out":2}]}
{"id":1306,"category":"array","hardness":"medium","fn":"reverse_list","text":"reverse a list of numbers","examples":[{"in":[[-1,2,3]],"out":[3,2,-1]},{"in":[[9]],"out":[9]},{"in":[[1,-2]],"out":[-2,1]},{"in":[[3,1,2]],"out":[2,1,3]},{"in":[[0,5,6,7]],"out":[7,6,5,0]}]}
{"id":1307,"category":"array","hardness":"medium","fn":"sum_absolute_values","text":"the sum of the absolute values in a list","examples":[{"in":[[-3,-4]],"out":7},{"in":[[1,-2]],"out":3},{"in":[[5]],"out":5},{"in":[[-1,4]],"out":5}]}
{"id":1308,"category":"array","hardness":"medium","fn":"count_less_than_zero","text":"how many numbers in a list are less than zero","examples":[{"in":[[-1,2,-3]],"out":2},{"in":[[1,2]],"out":0},{"in":[[-5,-6]],"out":2},{"in":[[0,-1]],"out":1}]}
{"id":1309,"category":"array","hardness":"medium","fn":"min_even","text":"the smallest even number in a list","examples":[{"in":[[5,4,2,6]],"out":2},{"in":[[3,8,10]],"out":8},{"in":[[7,6,1,4]],"out":4},{"in":[[9,2,5]],"out":2}]}
{"id":1310,"category":"array","hardness":"medium","fn":"absolute_first_last_diff","text":"the absolute difference between the first and last element","examples":[{"in":[[3,1,8]],"out":5},{"in":[[5,1,2]],"out":3},{"in":[[4,9]],"out":5},{"in":[[10,4]],"out":6}]}
{"id":1311,"category":"array","hardness":"medium","fn":"sum_negatives","text":"the sum of the negative numbers in a list","examples":[{"in":[[1,-2,-3]],"out":-5},{"in":[[-4,5]],"out":-4},{"in":[[3,-1,-2]],"out":-3}]}
{"id":1312,"category":"array","hardness":"medium","fn":"absolute_first","text":"the absolute value of the first element of a list","examples":[{"in":[[-8,3]],"out":8},{"in":[[5,2]],"out":5},{"in":[[-1,9,4]],"out":1}]}
{"id":1313,"category":"array","hardness":"medium","fn":"absolute_last","text":"the absolute value of the last element of a list","examples":[{"in":[[3,-8]],"out":8},{"in":[[5,2]],"out":2},{"in":[[1,9,-4]],"out":4}]}
