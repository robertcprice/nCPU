{"id":9001,"fn":"binary_search","text":"return the index of target in a sorted array, or -1 if absent","examples":[{"in":[[1,3,5,7,9],5],"out":2},{"in":[[1,3,5,7,9],1],"out":0},{"in":[[1,3,5,7,9],9],"out":4},{"in":[[1,3,5,7,9],4],"out":-1},{"in":[[2,4,6],6],"out":2}]}
{"id":9002,"fn":"fibonacci","text":"the nth fibonacci number","examples":[{"in":[0],"out":0},{"in":[1],"out":1},{"in":[2],"out":1},{"in":[7],"out":13},{"in":[10],"out":55}]}
{"id":9003,"fn":"factorial","text":"factorial of n","examples":[{"in":[0],"out":1},{"in":[1],"out":1},{"in":[3],"out":6},{"in":[5],"out":120},{"in":[6],"out":720}]}
{"id":9004,"fn":"power","text":"a raised to the power b","examples":[{"in":[2,0],"out":1},{"in":[2,10],"out":1024},{"in":[3,3],"out":27},{"in":[5,2],"out":25},{"in":[7,1],"out":7}]}
{"id":9005,"fn":"is_prime","text":"check whether a number is prime","examples":[{"in":[2],"out":true},{"in":[3],"out":true},{"in":[4],"out":false},{"in":[17],"out":true},{"in":[18],"out":false},{"in":[1],"out":false}]}
{"id":9006,"fn":"sort_ascending","text":"sort a list of numbers in ascending order","examples":[{"in":[[3,1,2]],"out":[1,2,3]},{"in":[[5,4,3,2,1]],"out":[1,2,3,4,5]},{"in":[[2,2,1]],"out":[1,2,2]},{"in":[[9]],"out":[9]},{"in":[[-1,3,-2]],"out":[-2,-1,3]}]}
{"id":9007,"fn":"max_subarray_sum","text":"the maximum sum of any contiguous subarray","examples":[{"in":[[-2,1,-3,4,-1,2,1,-5,4]],"out":6},{"in":[[1,2,3]],"out":6},{"in":[[-1,-2,-3]],"out":-1},{"in":[[5,-3,5]],"out":7},{"in":[[-5]],"out":-5}]}
{"id":9008,"fn":"lcs_length","text":"length of the longest common subsequence of two strings","examples":[{"in":["abcde","ace"],"out":3},{"in":["abc","abc"],"out":3},{"in":["abc","def"],"out":0},{"in":["aggtab","gxtxayb"],"out":4},{"in":["a",""],"out":0}]}
{"id":9009,"fn":"edit_distance","text":"the levenshtein edit distance between two strings","examples":[{"in":["kitten","sitting"],"out":3},{"in":["","abc"],"out":3},{"in":["abc","abc"],"out":0},{"in":["horse","ros"],"out":3},{"in":["a","b"],"out":1}]}
{"id":9010,"fn":"is_palindrome_str","text":"check whether a string is a palindrome","examples":[{"in":["racecar"],"out":true},{"in":["hello"],"out":false},{"in":["a"],"out":true},{"in":["abba"],"out":true},{"in":["ab"],"out":false}]}
{"id":9011,"fn":"count_vowels","text":"count the vowels in a string","examples":[{"in":["hello"],"out":2},{"in":["xyz"],"out":0},{"in":["aeiou"],"out":5},{"in":["Apple"],"out":2},{"in":["queue"],"out":4}]}
{"id":9012,"fn":"gcd","text":"greatest common divisor of two numbers","examples":[{"in":[12,8],"out":4},{"in":[17,5],"out":1},{"in":[100,10],"out":10},{"in":[54,24],"out":6},{"in":[7,7],"out":7}]}
{"id":9013,"fn":"collatz_steps","text":"number of steps to reach 1 in the collatz sequence","examples":[{"in":[1],"out":0},{"in":[2],"out":1},{"in":[6],"out":8},{"in":[7],"out":16},{"in":[27],"out":111}]}
{"id":9014,"fn":"count_set_bits","text":"count the number of 1 bits in the binary representation","examples":[{"in":[0],"out":0},{"in":[7],"out":3},{"in":[8],"out":1},{"in":[255],"out":8},{"in":[1024],"out":1}]}
{"id":9015,"fn":"digital_root","text":"repeatedly sum digits until a single digit remains","examples":[{"in":[0],"out":0},{"in":[38],"out":2},{"in":[123],"out":6},{"in":[9999],"out":9},{"in":[10],"out":1}]}
{"id":9016,"fn":"is_power_of_two","text":"check whether a number is a power of two","examples":[{"in":[1],"out":true},{"in":[2],"out":true},{"in":[3],"out":false},{"in":[16],"out":true},{"in":[18],"out":false}]}
{"id":9017,"fn":"sum_of_primes","text":"sum of all primes up to and including n","examples":[{"in":[2],"out":2},{"in":[5],"out":10},{"in":[10],"out":17},{"in":[1],"out":0},{"in":[11],"out":28}]}
{"id":9018,"fn":"reverse_words","text":"reverse the order of words in a sentence","examples":[{"in":["hello world"],"out":"world hello"},{"in":["a b c"],"out":"c b a"},{"in":["one"],"out":"one"},{"in":["the quick fox"],"out":"fox quick the"},{"in":["x y"],"out":"y x"}]}
{"id":9019,"fn":"nth_prime","text":"the nth prime number (1-indexed)","examples":[{"in":[1],"out":2},{"in":[2],"out":3},{"in":[3],"out":5},{"in":[5],"out":11},{"in":[10],"out":29}]}
{"id":9020,"fn":"count_islands","text":"count connected groups of 1s in a flattened row-major grid described as a list","examples":[{"in":[[1,0,1]],"out":2},{"in":[[1,1,1]],"out":1},{"in":[[0,0,0]],"out":0},{"in":[[1,0,0,1,0,1]],"out":3},{"in":[[1,1,0,1]],"out":2}]}
